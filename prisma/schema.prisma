// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ตารางข้อมูลผู้ใช้งานและผู้ดูแลระบบ
model User {
  /// รหัสอ้างอิงผู้ใช้งาน (PK, UUID)
  id String @id @default(uuid()) @db.Uuid

  /// อีเมลผู้ใช้งาน
  email String @unique

  /// รหัสผ่านที่เข้ารหัสแล้ว (PBKDF2/Bcrypt)
  passwordHash String @map("password_hash")

  /// ชื่อจริง-นามสกุล
  name String

  /// สิทธิ์ผู้ใช้งาน (super_admin = ผู้ดูแลใหญ่, admin = ผู้ดูแลตึก, tenant = ผู้เช่า)
  role String @default("tenant")

  /// เบอร์โทรศัพท์ติดต่อ
  phone String?

  /// วันเวลาที่สร้างเรคคอร์ด
  createdAt DateTime @default(now()) @map("created_at")

  /// วันเวลาที่อัปเดตเรคคอร์ดล่าสุด
  updatedAt DateTime @updatedAt @map("updated_at")

  buildingPermissions UserBuildingPermission[]
  auditLogs AuditLog[]
  ownedRooms Room[] @relation("RoomOwner")
  notificationLogs NotificationLog[]

  @@map("users")
}

/// ตารางสิทธิ์การเข้าถึงตึกของผู้ดูแลระบบ (Admin Building Permissions)
model UserBuildingPermission {
  /// รหัสอ้างอิงสิทธิ์ (PK, UUID)
  id String @id @default(uuid()) @db.Uuid

  /// รหัสอ้างอิงผู้ใช้งาน (Foreign Key)
  userId String @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// รหัสอ้างอิงตึก (Foreign Key)
  buildingId String @map("building_id") @db.Uuid
  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  /// วันเวลาที่สร้างเรคคอร์ด
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, buildingId])
  @@map("user_building_permissions")
}

/// ตารางอาคาร/ตึก (Building)
model Building {
  /// รหัสอ้างอิงตึก (PK, UUID)
  id String @id @default(uuid()) @db.Uuid

  /// ชื่อตึก (เช่น อาคาร A, อาคาร B)
  name String

  /// ที่อยู่หรือรายละเอียดตึก
  address String?

  /// ธีมสีหลักประจำตึกสำหรับ LIFF App (Hex Color e.g. #3B82F6 หรือ #EF4444)
  themeColor String @default("#3B82F6") @map("theme_color")

  /// รูปภาพโลโก้ประจำตึก (URL/Path)
  logoUrl String? @map("logo_url")

  /// วันเวลาที่สร้างเรคคอร์ด
  createdAt DateTime @default(now()) @map("created_at")

  /// วันเวลาที่อัปเดตเรคคอร์ดล่าสุด
  updatedAt DateTime @updatedAt @map("updated_at")

  rooms Room[]
  setting BuildingSetting?
  userPermissions UserBuildingPermission[]
  featureToggles FeatureToggle[]
  announcements Announcement[]
  parcels Parcel[]
  leaseContracts LeaseContract[]
  maintenanceRequests MaintenanceRequest[]
  lineAccounts UserLineAccount[]
  issueTickets IssueTicket[]
  notificationLogs NotificationLog[]

  @@map("buildings")
}

/// ตารางการตั้งค่าและบัญชีชำระเงินของแต่ละตึก (Building Settings)
model BuildingSetting {
  /// รหัสอ้างอิงการตั้งค่า (PK, UUID)
  id String @id @default(uuid()) @db.Uuid

  /// รหัสอ้างอิงตึก (Foreign Key, 1-to-1 Relation)
  buildingId String @unique @map("building_id") @db.Uuid
  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  // 1. General Settings (ข้อมูลทั่วไป)
  /// เบอร์โทรศัพท์ติดต่อประจำตึก
  phone String?
  /// รูปภาพหน้าปกตึก (URL/Path)
  coverImageUrl String? @map("cover_image_url")

  // 2. Payment Settings (การชำระเงิน)
  /// รูปภาพ PromptPay QR Code ชำระเงินประจำตึก (URL/Path)
  paymentQrUrl String? @map("payment_qr_url")
  /// หมายเลข PromptPay ประจำตึก (เช่น เบอร์โทรศัพท์ หรือ เลขประจำตัวผู้เสียภาษี)
  promptpayNum String? @map("promptpay_num")
  /// ชื่อธนาคารผู้รับชำระเงิน
  bankName String? @map("bank_name")
  /// ชื่อบัญชีธนาคาร
  bankAccountName String? @map("bank_account_name")
  /// เลขที่บัญชีธนาคาร
  bankAccountNo String? @map("bank_account_no")
  /// หมายเหตุเพิ่มเติมสำหรับการชำระเงิน
  paymentNote String? @map("payment_note") @db.Text

  // 3. Billing & Utility Rates (ค่าบริการและรอบบิล)
  /// อัตราค่าน้ำต่อหน่วย (Decimal)
  waterRate Decimal @default(18.00) @map("water_rate") @db.Decimal(10, 2)
  /// อัตราค่าไฟต่อหน่วย (Decimal)
  electricRate Decimal @default(7.00) @map("electric_rate") @db.Decimal(10, 2)
  /// วันกำหนดชำระเงินของทุกเดือน (เช่น วันที่ 5)
  dueDateDay Int @default(5) @map("due_date_day")
  /// ค่าปรับชำระเกินกำหนด (Decimal) - Deprecated Alias
  latePenalty Decimal @default(50.00) @map("late_penalty") @db.Decimal(10, 2)
  /// ประเภทนโยบายค่าปรับ (NONE = ไม่มี, DAILY = รายวัน, FLAT = เหมาจ่ายครั้งเดียว)
  lateFeeType String @default("NONE") @map("late_fee_type")
  /// จำนวนเงินค่าปรับ (Decimal)
  lateFeeAmount Decimal @default(0.00) @map("late_fee_amount") @db.Decimal(10, 2)
  /// ระยะเวลาผ่อนผันก่อนเริ่มคิดค่าปรับ (จำนวนวัน)
  gracePeriodDays Int @default(0) @map("grace_period_days")

  // 4. Rules & Contract Terms (กฎระเบียบและข้อตกลง)
  /// จำนวนเดือนเงินประกัน/มัดจำ (Int)
  depositMonths Int @default(2) @map("deposit_months")
  /// จำนวนเดือนเงินค่าเช่าล่วงหน้า (Int)
  advanceMonths Int @default(1) @map("advance_months")
  /// กฎระเบียบและข้อตกลงสัญญาเช่า (Text)
  termsAndConditions String? @map("terms_and_conditions") @db.Text

  // 5. LINE Official Account & LIFF Settings (การตั้งค่า LINE OA ประจำตึก)
  /// LINE OA Basic ID หรือ Handle (เช่น @horhub_a)
  lineOaId String? @map("line_oa_id")
  /// LINE Messaging API Channel Access Token ประจำตึก (Long-lived Token)
  lineChannelAccessToken String? @map("line_channel_access_token") @db.Text
  /// LINE Channel Secret ประจำตึก
  lineChannelSecret String? @map("line_channel_secret")
  /// LINE LIFF ID ประจำตึก (เช่น 200xxxxxxx-xxxxxxx)
  lineLiffId String? @map("line_liff_id")
  /// ลิงก์กดเพิ่มเพื่อน LINE OA (Add Friend URL เช่น https://line.me/R/ti/p/@horhub)
  lineAddFriendUrl String? @map("line_add_friend_url")

  /// วันเวลาที่สร้างเรคคอร์ด
  createdAt DateTime @default(now()) @map("created_at")
  /// วันเวลาที่อัปเดตเรคคอร์ดล่าสุด
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("building_settings")
}

/// ตารางข้อมูลห้องพัก
model Room {
  /// รหัสอ้างอิงห้องพัก (PK, UUID)
  id String @id @default(uuid()) @db.Uuid

  /// รหัสอ้างอิงตึก (Foreign Key ไปยังตาราง Building)
  buildingId String? @map("building_id") @db.Uuid
  building Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  /// หมายเลขห้องพัก (เช่น A101, B202)
  roomNumber String @map("room_number")

  /// ชั้นที่ห้องพักตั้งอยู่
  floor Int

  /// ราคาค่าเช่าห้องพักต่อเดือน
  price Decimal @db.Decimal(10, 2)

  /// สถานะห้องพัก (available = ว่าง, occupied = มีผู้เช่า, maintenance = ซ่อมบำรุง)
  status String @default("available")

  /// ประเภทสินทรัพย์/ยูนิตให้เช่า (residential, commercial_shop, vending_spot, parking, storage, billboard_rooftop)
  unitType String @default("residential") @map("unit_type")

  /// ขนาดพื้นที่เช่า (ตารางเมตร)
  areaSqm Decimal? @map("area_sqm") @db.Decimal(8, 2)

  /// ตำแหน่งโซนที่ตั้ง (เช่น ชั้น 1 ริมถนน, ลานจอดรถ A, ดาดฟ้า)
  locationZone String? @map("location_zone")

  /// รูปแบบการคิดค่าบริการ (fixed = เหมาจ่ายรายเดือน, revenue_share = ส่วนแบ่งยอดขาย, metered_only = คิดตามมิเตอร์)
  billingModel String @default("fixed") @map("billing_model")

  /// เปอร์เซ็นต์ส่วนแบ่งยอดขายกรณีเป็น Revenue Share (เช่น 10.00%)
  revSharePercent Decimal? @map("rev_share_percent") @db.Decimal(5, 2)

  /// เลขประจำตัวผู้เสียภาษี (กรณีนิติบุคคล/บริษัทเช่า)
  companyTaxId String? @map("company_tax_id")

  /// รหัสผู้เช่าปัจจุบัน (Foreign Key ไปยังตาราง Tenant)
  tenantId String? @map("tenant_id") @db.Uuid
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  /// รหัสเจ้าของห้อง (Foreign Key ไปยังตาราง User)
  ownerId String? @map("owner_id") @db.Uuid
  owner User? @relation("RoomOwner", fields: [ownerId], references: [id])

  /// วันเวลาที่สร้างเรคคอร์ด
  createdAt DateTime @default(now()) @map("created_at")

  /// วันเวลาที่อัปเดตเรคคอร์ดล่าสุด
  updatedAt DateTime @updatedAt @map("updated_at")

  // ความสัมพันธ์ (Relations)
  residents RoomResident[]
  meterRecords MeterRecord[]
  invoices Invoice[]
  maintenanceRequests MaintenanceRequest[]
  roomInvites RoomInvite[]
  parcels Parcel[]
  leaseContracts LeaseContract[]
  issueTickets IssueTicket[]
  notificationLogs NotificationLog[]

  // แมปชื่อตารางในฐานข้อมูลเป็น snake_case และพหูพจน์
  @@unique([roomNumber, buildingId])
  @@map("rooms")
}

/// ตารางข้อมูลผู้เช่า
model Tenant {
  /// รหัสอ้างอิงผู้เช่า (PK, UUID)
  id String @id @default(uuid()) @db.Uuid

  /// ชื่อจริงของผู้เช่า
  firstName String @map("first_name")

  /// นามสกุลของผู้เช่า
  lastName String @map("last_name")

  /// เบอร์โทรศัพท์ติดต่อ
  phone String

  /// รหัสผ่านสำหรับ Local Authentication (Bcrypt Hash, Nullable สำหรับคนที่ยังไม่เคยตั้ง)
  passwordHash String? @map("password_hash")

  /// รหัส PIN 6 หลักสำหรับ LIFF Seamless Auto-Login (Bcrypt Hash, Nullable)
  pinHash String? @map("pin_hash")

  /// เลขบัตรประจำตัวประชาชน
  idCard String? @map("id_card")

  /// LINE User ID สำหรับผูกกับระบบ LIFF (ไม่ซ้ำกัน)
  lineUserId String? @unique @map("line_user_id")

  /// LINE Display Name จากโปรไฟล์ LINE
  lineDisplayName String? @map("line_display_name")

  /// LINE Picture URL รูปโปรไฟล์จาก LINE
  linePictureUrl String? @map("line_picture_url")

  /// LINE Status Message ข้อความสถานะจาก LINE
  lineStatusMessage String? @map("line_status_message")

  /// รหัสเชิญ 6 หลักสำหรับผูกบัญชีลูกบ้าน (Alphanumeric)
  inviteCode String? @unique @map("invite_code")

  /// วันเวลาที่รหัสเชิญจะหมดอายุ
  inviteExpiresAt DateTime? @map("invite_expires_at")

  /// บันทึกภายในสำหรับแอดมิน (Internal Notes)
  internalNotes String? @map("internal_notes") @db.Text

  /// สถานะ Blacklist (true = ติด Blacklist, false = ปกติ)
  isBlacklisted Boolean @default(false) @map("is_blacklisted")

  /// วันเวลาที่สร้างเรคคอร์ด
  createdAt DateTime @default(now()) @map("created_at")

  /// วันเวลาที่อัปเดตเรคคอร์ดล่าสุด
  updatedAt DateTime @updatedAt @map("updated_at")

  // ความสัมพันธ์ (Relations)
  rooms Room[]
  roomResidents RoomResident[]
  invoices Invoice[]
  parcels Parcel[]
  leaseContracts LeaseContract[]
  maintenanceRequests MaintenanceRequest[]
  lineAccounts UserLineAccount[]
  announcementReads AnnouncementRead[]
  issueTickets IssueTicket[]
  notificationLogs NotificationLog[]

  @@map("tenants")
}

/// ตาราง Mapping LINE Account ประจำแต่ละตึก (1 ลูกบ้าน : หลาย LINE OA ID จากหลายตึก)
model UserLineAccount {
  /// รหัสอ้างอิง Mapping (PK, UUID)
  id String @id @default(uuid()) @db.Uuid

  /// รหัสอ้างอิงผู้เช่า/ลูกบ้านกลาง (Foreign Key)
  tenantId String @map("tenant_id") @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// รหัสอ้างอิงตึก/โครงการ (Foreign Key)
  buildingId String @map("building_id") @db.Uuid
  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  /// LINE User ID (Provider-specific User ID ประจำ LINE OA ตึกนั้น)
  lineUserId String @map("line_user_id")

  /// ชื่อโปรไฟล์ LINE
  lineDisplayName String? @map("line_display_name")

  /// รูปโปรไฟล์ LINE
  linePictureUrl String? @map("line_picture_url")

  /// ข้อความสถานะ LINE
  lineStatusMessage String? @map("line_status_message")

  /// วันเวลาที่เชื่อมต่อ
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Constraints & Indexes
  @@unique([buildingId, lineUserId], name: "buildingId_lineUserId")
  @@index([lineUserId])
  @@index([tenantId])
  @@index([buildingId])
  @@map("user_line_accounts")
}

/// ตารางประวัติการจดมิเตอร์น้ำและไฟ
model MeterRecord {
  /// รหัสอ้างอิงการจดมิเตอร์ (PK, UUID)
  id String @id @default(uuid()) @db.Uuid

  /// รหัสอ้างอิงห้องพัก (Foreign Key)
  roomId String @map("room_id") @db.Uuid
  room Room @relation(fields: [roomId], references: [id])

  /// ประเภทของมิเตอร์ (water = น้ำ, electric = ไฟ)
  meterType String @map("meter_type")

  /// เลขมิเตอร์ของเดือนที่แล้ว
  previousReading Decimal @map("previous_reading") @db.Decimal(10, 2)

  /// เลขมิเตอร์ของเดือนปัจจุบัน
  currentReading Decimal @map("current_reading") @db.Decimal(10, 2)

  /// จำนวนหน่วยที่ใช้ไป
  unitsUsed Decimal @map("units_used") @db.Decimal(10, 2)

  /// รอบบิลที่ทำการจด (รูปแบบเดือน/ปี เช่น 08-2026)
  billingCycle String @map("billing_cycle")

  /// วันที่และเวลาที่เดินจดเลขมิเตอร์
  recordedAt DateTime @map("recorded_at")

  /// วันเวลาที่สร้างเรคคอร์ด
  createdAt DateTime @default(now()) @map("created_at")

  /// วันเวลาที่อัปเดตเรคคอร์ดล่าสุด
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("meter_records")
}

/// ตารางใบแจ้งหนี้ (บิลค่าเช่า)
model Invoice {
  /// รหัสอ้างอิงใบแจ้งหนี้ (PK, UUID)
  id String @id @default(uuid()) @db.Uuid

  /// หมายเลขใบแจ้งหนี้ (เช่น INV-202608-101)
  invoiceNumber String @unique @map("invoice_number")

  /// รหัสอ้างอิงห้องพัก (Foreign Key)
  roomId String @map("room_id") @db.Uuid
  room Room @relation(fields: [roomId], references: [id])

  /// รหัสอ้างอิงผู้เช่า ณ วันที่ออกบิล (Foreign Key)
  tenantId String @map("tenant_id") @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])

  /// รอบบิล (รูปแบบเดือน/ปี เช่น 08-2026)
  billingCycle String @map("billing_cycle")

  /// ค่าเช่าห้องพักที่ล็อคไว้ ณ เดือนนั้น
  roomPrice Decimal @map("room_price") @db.Decimal(10, 2)

  /// ยอดรวมค่าน้ำที่คำนวณแล้ว
  waterTotal Decimal @map("water_total") @db.Decimal(10, 2)

  /// ยอดรวมค่าไฟที่คำนวณแล้ว
  electricTotal Decimal @map("electric_total") @db.Decimal(10, 2)

  /// ค่าส่วนกลางคงที่
  commonFee Decimal @default(100.00) @map("common_fee") @db.Decimal(10, 2)

  /// ค่าบริการอื่นๆ เพิ่มเติม (เช่น ค่าจอดรถ, ค่าคีย์การ์ด)
  otherFee Decimal @default(0.00) @map("other_fee") @db.Decimal(10, 2)

  /// หมายเหตุค่าบริการอื่นๆ
  otherFeeNote String? @map("other_fee_note")

  /// ค่าปรับชำระล่าช้า (Late Fee)
  lateFeeCharge Decimal @default(0.00) @map("late_fee_charge") @db.Decimal(10, 2)

  /// ยอดเงินสุทธิที่ต้องชำระ (ค่าห้อง + ค่าน้ำ + ค่าไฟ + ค่าส่วนกลาง + ค่าอื่นๆ + ค่าปรับ)
  grandTotal Decimal @map("grand_total") @db.Decimal(10, 2)

  /// สถานะการชำระเงิน (pending = รอชำระ, paid = ชำระแล้ว, overdue = เกินกำหนด)
  status String @default("pending")

  /// สลิปโอนเงิน (URL/Path)
  slipUrl String? @map("slip_url")

  /// SHA-256 Checksum ของไฟล์สลิปที่แนบมา ใช้ตรวจจับการนำสลิปเดิมมาใช้ซ้ำข้ามบิล (Replay Protection)
  slipHash String? @map("slip_hash")

  /// วันครบกำหนดชำระเงิน
  dueDate DateTime @map("due_date")

  /// วันเวลาที่ชำระเงินเสร็จสิ้น
  paidAt DateTime? @map("paid_at")

  /// ช่องทางการชำระเงิน (CASH = เงินสด, PROMPTPAY = พร้อมเพย์, BANK_TRANSFER = โอนเงิน)
  paymentMethod String? @map("payment_method")

  /// หมายเหตุการชำระเงิน (เช่น เงินสดรับ 5000 ทอน 200)
  paymentNote String? @map("payment_note")

  /// วันเวลาที่สร้างเรคคอร์ด
  createdAt DateTime @default(now()) @map("created_at")

  /// วันเวลาที่อัปเดตเรคคอร์ดล่าสุด
  updatedAt DateTime @updatedAt @map("updated_at")

