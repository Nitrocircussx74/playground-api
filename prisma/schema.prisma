// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ตารางข้อมูลผู้ใช้งานและผู้ดูแลระบบ
model User {
  /// รหัสอ้างอิงผู้ใช้งาน (PK, UUID)
  id String @id @default(uuid()) @db.Uuid

  /// อีเมลผู้ใช้งาน
  email String @unique

  /// รหัสผ่านที่เข้ารหัสแล้ว (PBKDF2/Bcrypt)
  passwordHash String @map("password_hash")

  /// ชื่อจริง-นามสกุล
  name String

  /// สิทธิ์ผู้ใช้งาน (super_admin = ผู้ดูแลใหญ่, admin = ผู้ดูแลตึก, tenant = ผู้เช่า)
  role String @default("tenant")

  /// เบอร์โทรศัพท์ติดต่อ
  phone String?

  /// วันเวลาที่สร้างเรคคอร์ด
  createdAt DateTime @default(now()) @map("created_at")

  /// วันเวลาที่อัปเดตเรคคอร์ดล่าสุด
  updatedAt DateTime @updatedAt @map("updated_at")

  buildingPermissions UserBuildingPermission[]
  auditLogs AuditLog[]

  @@map("users")
}

/// ตารางสิทธิ์การเข้าถึงตึกของผู้ดูแลระบบ (Admin Building Permissions)
model UserBuildingPermission {
  /// รหัสอ้างอิงสิทธิ์ (PK, UUID)
  id String @id @default(uuid()) @db.Uuid

  /// รหัสอ้างอิงผู้ใช้งาน (Foreign Key)
  userId String @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// รหัสอ้างอิงตึก (Foreign Key)
  buildingId String @map("building_id") @db.Uuid
  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  /// วันเวลาที่สร้างเรคคอร์ด
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, buildingId])
  @@map("user_building_permissions")
}

/// ตารางอาคาร/ตึก (Building)
model Building {
  /// รหัสอ้างอิงตึก (PK, UUID)
  id String @id @default(uuid()) @db.Uuid

  /// ชื่อตึก (เช่น อาคาร A, อาคาร B)
  name String

  /// ที่อยู่หรือรายละเอียดตึก
  address String?

  /// วันเวลาที่สร้างเรคคอร์ด
  createdAt DateTime @default(now()) @map("created_at")

  /// วันเวลาที่อัปเดตเรคคอร์ดล่าสุด
  updatedAt DateTime @updatedAt @map("updated_at")

  rooms Room[]
  setting BuildingSetting?
  userPermissions UserBuildingPermission[]
  featureToggles FeatureToggle[]
  announcements Announcement[]
  parcels Parcel[]
  leaseContracts LeaseContract[]
  maintenanceRequests MaintenanceRequest[]

  @@map("buildings")
}

/// ตารางการตั้งค่าและบัญชีชำระเงินของแต่ละตึก (Building Settings)
model BuildingSetting {
  /// รหัสอ้างอิงการตั้งค่า (PK, UUID)
  id String @id @default(uuid()) @db.Uuid

  /// รหัสอ้างอิงตึก (Foreign Key, 1-to-1 Relation)
  buildingId String @unique @map("building_id") @db.Uuid
  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  // 1. General Settings (ข้อมูลทั่วไป)
  /// เบอร์โทรศัพท์ติดต่อประจำตึก
  phone String?
  /// รูปภาพหน้าปกตึก (URL/Path)
  coverImageUrl String? @map("cover_image_url")

  // 2. Payment Settings (การชำระเงิน)
  /// รูปภาพ PromptPay QR Code ชำระเงินประจำตึก (URL/Path)
  paymentQrUrl String? @map("payment_qr_url")
  /// หมายเลข PromptPay ประจำตึก (เช่น เบอร์โทรศัพท์ หรือ เลขประจำตัวผู้เสียภาษี)
  promptpayNum String? @map("promptpay_num")
  /// ชื่อธนาคารผู้รับชำระเงิน
  bankName String? @map("bank_name")
  /// ชื่อบัญชีธนาคาร
  bankAccountName String? @map("bank_account_name")
  /// เลขที่บัญชีธนาคาร
  bankAccountNo String? @map("bank_account_no")
  /// หมายเหตุเพิ่มเติมสำหรับการชำระเงิน
  paymentNote String? @map("payment_note") @db.Text

  // 3. Billing & Utility Rates (ค่าบริการและรอบบิล)
  /// อัตราค่าน้ำต่อหน่วย (Decimal)
  waterRate Decimal @default(18.00) @map("water_rate") @db.Decimal(10, 2)
  /// อัตราค่าไฟต่อหน่วย (Decimal)
  electricRate Decimal @default(7.00) @map("electric_rate") @db.Decimal(10, 2)
  /// วันกำหนดชำระเงินของทุกเดือน (เช่น วันที่ 5)
  dueDateDay Int @default(5) @map("due_date_day")
  /// ค่าปรับชำระเกินกำหนด (Decimal)
  latePenalty Decimal @default(50.00) @map("late_penalty") @db.Decimal(10, 2)

  // 4. Rules & Contract Terms (กฎระเบียบและข้อตกลง)
  /// จำนวนเดือนเงินประกัน/มัดจำ (Int)
  depositMonths Int @default(2) @map("deposit_months")
  /// จำนวนเดือนเงินค่าเช่าล่วงหน้า (Int)
  advanceMonths Int @default(1) @map("advance_months")
  /// กฎระเบียบและข้อตกลงสัญญาเช่า (Text)
  termsAndConditions String? @map("terms_and_conditions") @db.Text

  /// วันเวลาที่สร้างเรคคอร์ด
  createdAt DateTime @default(now()) @map("created_at")
  /// วันเวลาที่อัปเดตเรคคอร์ดล่าสุด
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("building_settings")
}

/// ตารางข้อมูลห้องพัก
model Room {
  /// รหัสอ้างอิงห้องพัก (PK, UUID)
  id String @id @default(uuid()) @db.Uuid

  /// รหัสอ้างอิงตึก (Foreign Key ไปยังตาราง Building)
  buildingId String? @map("building_id") @db.Uuid
  building Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  /// หมายเลขห้องพัก (เช่น A101, B202)
  roomNumber String @map("room_number")

  /// ชั้นที่ห้องพักตั้งอยู่
  floor Int

  /// ราคาค่าเช่าห้องพักต่อเดือน
  price Decimal @db.Decimal(10, 2)

  /// สถานะห้องพัก (available = ว่าง, occupied = มีผู้เช่า, maintenance = ซ่อมบำรุง)
  status String @default("available")

  /// รหัสผู้เช่าปัจจุบัน (Foreign Key ไปยังตาราง Tenant)
  tenantId String? @map("tenant_id") @db.Uuid
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  /// วันเวลาที่สร้างเรคคอร์ด
  createdAt DateTime @default(now()) @map("created_at")

  /// วันเวลาที่อัปเดตเรคคอร์ดล่าสุด
  updatedAt DateTime @updatedAt @map("updated_at")

  // ความสัมพันธ์ (Relations)
  meterRecords MeterRecord[]
  invoices Invoice[]
  maintenanceRequests MaintenanceRequest[]
  roomInvites RoomInvite[]
  parcels Parcel[]
  leaseContracts LeaseContract[]

  // แมปชื่อตารางในฐานข้อมูลเป็น snake_case และพหูพจน์
  @@unique([roomNumber, buildingId])
  @@map("rooms")
}

/// ตารางข้อมูลผู้เช่า
model Tenant {
  /// รหัสอ้างอิงผู้เช่า (PK, UUID)
  id String @id @default(uuid()) @db.Uuid

  /// ชื่อจริงของผู้เช่า
  firstName String @map("first_name")

  /// นามสกุลของผู้เช่า
  lastName String @map("last_name")

  /// เบอร์โทรศัพท์ติดต่อ
  phone String

  /// เลขบัตรประจำตัวประชาชน
  idCard String? @map("id_card")

  /// LINE User ID สำหรับผูกกับระบบ LIFF (ไม่ซ้ำกัน)
  lineUserId String? @unique @map("line_user_id")

  /// รหัสเชิญ 6 หลักสำหรับผูกบัญชีลูกบ้าน (Alphanumeric)
  inviteCode String? @unique @map("invite_code")

  /// วันเวลาที่รหัสเชิญจะหมดอายุ
  inviteExpiresAt DateTime? @map("invite_expires_at")

  /// วันเวลาที่สร้างเรคคอร์ด
  createdAt DateTime @default(now()) @map("created_at")

  /// วันเวลาที่อัปเดตเรคคอร์ดล่าสุด
  updatedAt DateTime @updatedAt @map("updated_at")

  // ความสัมพันธ์ (Relations)
  rooms Room[]
  invoices Invoice[]
  parcels Parcel[]
  leaseContracts LeaseContract[]
  maintenanceRequests MaintenanceRequest[]

  @@map("tenants")
}

/// ตารางประวัติการจดมิเตอร์น้ำและไฟ
model MeterRecord {
  /// รหัสอ้างอิงการจดมิเตอร์ (PK, UUID)
  id String @id @default(uuid()) @db.Uuid

  /// รหัสอ้างอิงห้องพัก (Foreign Key)
  roomId String @map("room_id") @db.Uuid
  room Room @relation(fields: [roomId], references: [id])

  /// ประเภทของมิเตอร์ (water = น้ำ, electric = ไฟ)
  meterType String @map("meter_type")

  /// เลขมิเตอร์ของเดือนที่แล้ว
  previousReading Decimal @map("previous_reading") @db.Decimal(10, 2)

  /// เลขมิเตอร์ของเดือนปัจจุบัน
  currentReading Decimal @map("current_reading") @db.Decimal(10, 2)

  /// จำนวนหน่วยที่ใช้ไป
  unitsUsed Decimal @map("units_used") @db.Decimal(10, 2)

  /// รอบบิลที่ทำการจด (รูปแบบเดือน/ปี เช่น 08-2026)
  billingCycle String @map("billing_cycle")

  /// วันที่และเวลาที่เดินจดเลขมิเตอร์
  recordedAt DateTime @map("recorded_at")

  /// วันเวลาที่สร้างเรคคอร์ด
  createdAt DateTime @default(now()) @map("created_at")

  /// วันเวลาที่อัปเดตเรคคอร์ดล่าสุด
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("meter_records")
}

/// ตารางใบแจ้งหนี้ (บิลค่าเช่า)
model Invoice {
  /// รหัสอ้างอิงใบแจ้งหนี้ (PK, UUID)
  id String @id @default(uuid()) @db.Uuid

  /// หมายเลขใบแจ้งหนี้ (เช่น INV-202608-101)
  invoiceNumber String @unique @map("invoice_number")

  /// รหัสอ้างอิงห้องพัก (Foreign Key)
  roomId String @map("room_id") @db.Uuid
  room Room @relation(fields: [roomId], references: [id])

  /// รหัสอ้างอิงผู้เช่า ณ วันที่ออกบิล (Foreign Key)
  tenantId String @map("tenant_id") @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])

  /// รอบบิล (รูปแบบเดือน/ปี เช่น 08-2026)
  billingCycle String @map("billing_cycle")

  /// ค่าเช่าห้องพักที่ล็อคไว้ ณ เดือนนั้น
  roomPrice Decimal @map("room_price") @db.Decimal(10, 2)

  /// ยอดรวมค่าน้ำที่คำนวณแล้ว
  waterTotal Decimal @map("water_total") @db.Decimal(10, 2)

  /// ยอดรวมค่าไฟที่คำนวณแล้ว
  electricTotal Decimal @map("electric_total") @db.Decimal(10, 2)

  /// ค่าส่วนกลางคงที่
  commonFee Decimal @default(100.00) @map("common_fee") @db.Decimal(10, 2)

  /// ค่าบริการอื่นๆ เพิ่มเติม (เช่น ค่าจอดรถ, ค่าคีย์การ์ด)
  otherFee Decimal @default(0.00) @map("other_fee") @db.Decimal(10, 2)

  /// หมายเหตุค่าบริการอื่นๆ
  otherFeeNote String? @map("other_fee_note")

  /// ยอดเงินสุทธิที่ต้องชำระ (ค่าห้อง + ค่าน้ำ + ค่าไฟ + ค่าอื่นๆ)
  grandTotal Decimal @map("grand_total") @db.Decimal(10, 2)

  /// สถานะการชำระเงิน (pending = รอชำระ, paid = ชำระแล้ว, overdue = เกินกำหนด)
  status String @default("pending")

  /// สลิปโอนเงิน (URL/Path)
  slipUrl String? @map("slip_url")

  /// วันครบกำหนดชำระเงิน
  dueDate DateTime @map("due_date")

  /// วันเวลาที่ชำระเงินเสร็จสิ้น
  paidAt DateTime? @map("paid_at")

  /// ช่องทางการชำระเงิน (CASH = เงินสด, PROMPTPAY = พร้อมเพย์, BANK_TRANSFER = โอนเงิน)
  paymentMethod String? @map("payment_method")

  /// หมายเหตุการชำระเงิน (เช่น เงินสดรับ 5000 ทอน 200)
  paymentNote String? @map("payment_note")

  /// วันเวลาที่สร้างเรคคอร์ด
  createdAt DateTime @default(now()) @map("created_at")

  /// วันเวลาที่อัปเดตเรคคอร์ดล่าสุด
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("invoices")
}

/// ตารางแจ้งซ่อมแซมสิ่งอำนวยความสะดวกในห้องพัก
model MaintenanceRequest {
  /// รหัสอ้างอิงรายการแจ้งซ่อม (PK, UUID)
  id String @id @default(uuid()) @db.Uuid

  /// รหัสอ้างอิงห้องพัก (Foreign Key)
  roomId String @map("room_id") @db.Uuid
  room Room @relation(fields: [roomId], references: [id])

  /// รหัสอ้างอิงผู้เช่า (Foreign Key)
  tenantId String? @map("tenant_id") @db.Uuid
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  /// รหัสอ้างอิงอาคาร/ตึก (Foreign Key)
  buildingId String? @map("building_id") @db.Uuid
  building Building? @relation(fields: [buildingId], references: [id])

  /// หัวข้อเรื่องที่แจ้งซ่อม
  title String

  /// รายละเอียดการแจ้งซ่อม
  description String

  /// รูปภาพประกอบการแจ้งซ่อม (URL/Path)
  imageUrl String? @map("image_url")
  photoUrl String? @map("photo_url")

  /// ชื่อช่างผู้รับผิดชอบงานซ่อม
  technicianName String? @map("technician_name")

  /// ค่าซ่อมแซม/ค่าอะไหล่เพิ่มเติม
  repairCost Decimal @default(0) @map("repair_cost") @db.Decimal(10, 2)

  /// ข้อความตอบกลับ/บันทึกจากแอดมินหรือช่างซ่อม
  adminNote String? @map("admin_note") @db.Text

  /// สถานะการดำเนินการ (pending = รอดำเนินการ, in_progress = กำลังซ่อม, resolved = ซ่อมเสร็จสิ้น, cancelled = ยกเลิก)
  status String @default("pending")

  /// วันเวลาที่ปิดงานซ่อมเสร็จสิ้น
  resolvedAt DateTime? @map("resolved_at")

  /// วันเวลาที่สร้างเรคคอร์ด
  createdAt DateTime @default(now()) @map("created_at")

  /// วันเวลาที่อัปเดตเรคคอร์ดล่าสุด
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("maintenance_requests")
}

/// ตารางรหัสเชิญสำหรับลงทะเบียนผู้เช่าห้องพัก (Invite Codes)
model RoomInvite {
  /// รหัสอ้างอิงรหัสเชิญ (PK, UUID)
  id String @id @default(uuid()) @db.Uuid

  /// รหัสอ้างอิงห้องพัก (Foreign Key)
  roomId String @map("room_id") @db.Uuid
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  /// รหัสเชิญลงทะเบียน (เช่น X9K2P4, INV101)
  code String @unique

  /// วันเวลาหมดอายุของรหัสเชิญ
  expiresAt DateTime @map("expires_at")

  /// สถานะการใช้งานรหัสเชิญ (true = ถูกใช้งานแล้ว, false = ยังไม่ได้ใช้งาน)
  isUsed Boolean @default(false) @map("is_used")

  /// วันเวลาที่สร้างเรคคอร์ด
  createdAt DateTime @default(now()) @map("created_at")

  /// วันเวลาที่อัปเดตเรคคอร์ดล่าสุด
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("room_invites")
}

/// ตารางข่าวสารและประกาศจากแอดมินหอพัก (Announcements & Broadcasts)
model Announcement {
  /// รหัสอ้างอิงประกาศ (PK, UUID)
  id String @id @default(uuid()) @db.Uuid

  /// หัวข้อประกาศ
  title String

  /// รายละเอียดประกาศ
  content String @db.Text

  /// รูปภาพประกอบประกาศ (URL/Path)
  imageUrl String? @map("image_url")

  /// ประเภทเป้าหมาย (all = ผู้เช่าทั้งหมด, floor = ระบุชั้น, room = ระบุห้อง)
  targetType String @map("target_type")

  /// ค่าของเป้าหมาย (เช่น เลขชั้น '3' หรือ UUID ของห้อง)
  targetValue String? @map("target_value")

  /// แอดมินผู้สร้างประกาศ
  createdBy String? @map("created_by")

  /// รหัสอ้างอิงตึก (Foreign Key, Optional)
  buildingId String? @map("building_id") @db.Uuid
  building Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  /// วันเวลาที่สร้างเรคคอร์ด
  createdAt DateTime @default(now()) @map("created_at")

  /// วันเวลาที่อัปเดตเรคคอร์ดล่าสุด
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("announcements")
}

/// ตารางจัดการสวิตช์เปิด-ปิดฟีเจอร์ของระบบ (Feature Flags / Feature Toggles)
model FeatureToggle {
  /// รหัสอ้างอิงฟีเจอร์ (PK, UUID)
  id String @id @default(uuid()) @db.Uuid

  /// คีย์อ้างอิงฟีเจอร์ (เช่น ENABLE_VEHICLE_MANAGEMENT, ENABLE_PARCEL_NOTIFY)
  key String

  /// สถานะเปิดใช้งานฟีเจอร์ (true = เปิดใช้งาน, false = ปิดใช้งาน)
  isActive Boolean @default(true) @map("is_active")

  /// คำอธิบายรายละเอียดฟีเจอร์
  description String?

  /// รหัสอ้างอิงตึก (Foreign Key, Optional)
  buildingId String? @map("building_id") @db.Uuid
  building Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  /// วันเวลาที่สร้างเรคคอร์ด
  createdAt DateTime @default(now()) @map("created_at")

  /// วันเวลาที่อัปเดตเรคคอร์ดล่าสุด
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([key, buildingId])
  @@map("feature_toggles")
}

/// ตารางบันทึกประวัติการใช้งานระบบ (Audit Logs / Activity History)
model AuditLog {
  /// รหัสอ้างอิง Audit Log (PK, UUID)
  id String @id @default(uuid()) @db.Uuid

  /// รหัสแอดมินผู้ดำเนินการ (Foreign Key)
  adminId String @map("admin_id") @db.Uuid
  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  /// ประเภทการกระทำ (CREATE, UPDATE, DELETE)
  action String

  /// โมดูลที่ดำเนินการ (เช่น ROOM, INVOICE, TENANT, BUILDING_SETTING, ANNOUNCEMENT, USER)
  entity String

  /// รหัสอ้างอิงของวัตถุที่ถูกดำเนินการ (เช่น ID ของบิล หรือ ID ของห้อง)
  entityId String? @map("entity_id")

  /// ค่าข้อมูลก่อนการแก้ไข (JSON)
  oldValues Json? @map("old_values")

  /// ค่าข้อมูลหลังการแก้ไข (JSON)
  newValues Json? @map("new_values")

  /// วันเวลาที่บันทึก Log
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

/// ตารางจัดการพัสดุสำหรับลูกบ้าน (Smart Parcel Management)
model Parcel {
  /// รหัสอ้างอิงพัสดุ (PK, UUID)
  id String @id @default(uuid()) @db.Uuid

  /// รหัสอ้างอิงห้องพัก (Foreign Key)
  roomId String @map("room_id") @db.Uuid
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  /// รหัสอ้างอิงตึก (Foreign Key)
  buildingId String @map("building_id") @db.Uuid
  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  /// รหัสอ้างอิงผู้เช่า (Foreign Key, Optional)
  tenantId String? @map("tenant_id") @db.Uuid
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  /// หมายเลขพัสดุ / Tracking Number
  trackingNumber String? @map("tracking_number")

  /// บริษัทขนส่ง (เช่น Shopee Express, Kerry, Flash, J&T, ไปรษณีย์ไทย)
  courier String

  /// รูปภาพหน้ากล่องพัสดุ (URL/Path)
  photoUrl String? @map("photo_url")

  /// สถานะพัสดุ (PENDING = รอรับ, PICKED_UP = รับแล้ว)
  status String @default("PENDING")

  /// วันเวลาที่รับพัสดุเข้าออฟฟิศ
  receivedAt DateTime @default(now()) @map("received_at")

  /// วันเวลาที่ลูกบ้านมารับพัสดุไป
  pickedUpAt DateTime? @map("picked_up_at")

  /// วันเวลาที่สร้างเรคคอร์ด
  createdAt DateTime @default(now()) @map("created_at")

  /// วันเวลาที่อัปเดตเรคคอร์ดล่าสุด
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("parcels")
}

/// ตารางสัญญาเช่าและประวัติการเข้าอยู่ของผู้เช่า (Contract-Based Tenancy History)
model LeaseContract {
  /// รหัสอ้างอิงสัญญาเช่า (PK, UUID)
  id String @id @default(uuid()) @db.Uuid

  /// รหัสอ้างอิงห้องพัก (Foreign Key)
  roomId String @map("room_id") @db.Uuid
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  /// รหัสอ้างอิงผู้เช่า (Foreign Key)
  tenantId String @map("tenant_id") @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// รหัสอ้างอิงตึก (Foreign Key, Optional)
  buildingId String? @map("building_id") @db.Uuid
  building Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  /// วันที่เริ่มสัญญา / เข้าอยู่จริง
  startDate DateTime @map("start_date")

  /// วันที่สิ้นสุดสัญญาตามกำหนด
  expectedEndDate DateTime @map("expected_end_date")

  /// วันที่ย้ายออกจริง (Nullable)
  actualEndDate DateTime? @map("actual_end_date")

  /// จำนวนเงินประกัน/มัดจำ (Decimal)
  depositAmount Decimal @default(0.00) @map("deposit_amount") @db.Decimal(10, 2)

  /// สถานะสัญญา (ACTIVE = กำลังเช่าอยู่, ENDED = สิ้นสุดสัญญา/ย้ายออกแล้ว, CANCELLED = ยกเลิกสัญญา)
  status String @default("ACTIVE")

  /// เหตุผลที่ย้ายออก (Nullable)
  moveOutReason String? @map("move_out_reason")

  /// บันทึกหมายเหตุภายในสำหรับแอดมิน (เช่น Blacklist / หมายเหตุเพิ่มเติม)
  adminNote String? @map("admin_note") @db.Text

  /// วันเวลาที่สร้างเรคคอร์ด
  createdAt DateTime @default(now()) @map("created_at")

  /// วันเวลาที่อัปเดตเรคคอร์ดล่าสุด
  updatedAt DateTime @updatedAt @map("updated_at")

  moveOutRecord MoveOutRecord?

  @@map("lease_contracts")
}

/// ตารางบันทึกการแจ้งย้ายออกและคำนวณคืนเงินมัดจำ (Move-out & Deposit Refund Record)
model MoveOutRecord {
  /// รหัสอ้างอิง MoveOutRecord (PK, UUID)
  id String @id @default(uuid()) @db.Uuid

  /// รหัสสัญญาเช่า (Foreign Key, Unique 1-to-1)
  leaseId String @unique @map("lease_id") @db.Uuid
  lease LeaseContract @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  /// วันที่ย้ายออกจริง
  moveOutDate DateTime @map("move_out_date")

  /// เลขมิเตอร์น้ำวันย้ายออก
  finalWaterMeter Int @default(0) @map("final_water_meter")

  /// เลขมิเตอร์ไฟวันย้ายออก
  finalElectricMeter Int @default(0) @map("final_electric_meter")

  /// ยอดค่าน้ำรอบสุดท้าย (Decimal)
  finalWaterTotal Decimal @default(0.00) @map("final_water_total") @db.Decimal(10, 2)

  /// ยอดค่าไฟรอบสุดท้าย (Decimal)
  finalElectricTotal Decimal @default(0.00) @map("final_electric_total") @db.Decimal(10, 2)

  /// ยอดบิลค้างชำระเดิม (Decimal)
  unpaidInvoicesTotal Decimal @default(0.00) @map("unpaid_invoices_total") @db.Decimal(10, 2)

  /// รายการค่าปรับ/ค่าทำความสะอาด/ค่าเสียหาย (JSON Array)
  damageCharges Json? @map("damage_charges")

  /// รวมยอดหักทั้งหมด (Decimal)
  totalDeductions Decimal @default(0.00) @map("total_deductions") @db.Decimal(10, 2)

  /// ยอดเงินมัดจำเดิม (Decimal)
  depositAmount Decimal @default(0.00) @map("deposit_amount") @db.Decimal(10, 2)

  /// ยอดเงินคืนมัดจำสุทธิ (Decimal)
  netRefund Decimal @default(0.00) @map("net_refund") @db.Decimal(10, 2)

  /// สถานะการคืนเงิน (PENDING = รอคืน/รอชำระ, PAID = จบงานคืนเงิน/รับเงินแล้ว)
  refundStatus String @default("PENDING") @map("refund_status")

  /// วันเวลาที่สร้างเรคคอร์ด
  createdAt DateTime @default(now()) @map("created_at")

  /// วันเวลาที่อัปเดตเรคคอร์ดล่าสุด
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("move_out_records")
}