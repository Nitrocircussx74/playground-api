  /// วันเวลาที่สร้างเรคคอร์ด
  createdAt DateTime @default(now()) @map("created_at")

  /// วันเวลาที่อัปเดตเรคคอร์ดล่าสุด
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("issue_tickets")
}

/// ตารางประวัติการส่งข้อความแจ้งเตือน LINE (LINE Notification / Delivery Logs)
model NotificationLog {
  /// รหัสอ้างอิงบันทึกประวัติ (PK, UUID)
  id String @id @default(uuid()) @db.Uuid

  /// รหัสตึก/อาคาร (Foreign Key)
  buildingId String @map("building_id") @db.Uuid
  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  /// รหัสผู้ใช้งาน (Nullable)
  userId String? @map("user_id") @db.Uuid
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// รหัสผู้เช่า (Nullable)
  tenantId String? @map("tenant_id") @db.Uuid
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  /// รหัสห้องพัก (Nullable)
  roomId String? @map("room_id") @db.Uuid
  room Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  /// ประเภทการแจ้งเตือน (INVOICE = บิลค่าเช่า, PARCEL = พัสดุ, MAINTENANCE = แจ้งซ่อม, GENERAL = ทั่วไป)
  notificationType String @default("GENERAL") @map("notification_type")

  /// ข้อความตัวอย่าง/หัวข้อสั้นๆ ของการแจ้งเตือน
  messagePreview String @map("message_preview") @db.Text

  /// สถานะการส่ง (SUCCESS = ส่งสำเร็จ, FAILED = ส่งล้มเหลว)
  status String @default("SUCCESS")

  /// สาเหตุข้อผิดพลาด (ถ้ามี เช่น บล็อกบอท, Token หมดอายุ)
  errorReason String? @map("error_reason") @db.Text

  /// วันเวลาที่ส่งข้อความ
  sentAt DateTime @default(now()) @map("sent_at")

  @@index([buildingId, sentAt])
  @@index([buildingId, status])
  @@map("notification_logs")
}