{
  "name": "node-express-auth-starter",
  "version": "1.0.0",
  "description": "โครงสร้างโปรเจกต์ Node.js + Express API ระดับ Production-Ready อิงตาม JWT Best Practices (Dual Token & HttpOnly Cookies)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "tunnel": "node scripts/tunnel.js 3000",
    "dev:tunnel": "concurrently -n \"API,TUNNEL\" -c \"blue,magenta\" \"nodemon src/server.js\" \"node scripts/tunnel.js 3000\"",
    "migrate": "node src/migrations/migrate.js",
    "seed": "node prisma/seed.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "nodejs",
    "express",
    "jwt",
    "jwt-best-practices",
    "oauth2",
    "passport",
    "google-auth",
    "postgresql",
    "pg",
    "zod",
    "helmet",
    "rate-limit",
    "cookie-parser",
    "migrations"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@line/bot-sdk": "^11.2.0",
    "@prisma/client": "5.22.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.20.1",
    "pg": "^8.11.5",
    "promptpay-qr": "^0.5.0",
    "qrcode": "^1.5.4",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prisma": "5.22.0",
    "supertest": "^7.0.0"
  }
}
