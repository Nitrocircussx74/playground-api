# การตั้งค่าพอร์ตของเซิร์ฟเวอร์
PORT=3000
NODE_ENV=development

# การตั้งค่า PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=playground_db
DB_SSL=false

# การตั้งค่า JSON Web Token (JWT Best Practices - Dual Token System)
JWT_ACCESS_SECRET=your_super_secret_access_token_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# การตั้งค่า Google OAuth 2.0 (รับค่าได้จาก Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# URL สำหรับฝั่ง Frontend Client (สำคัญ: สำหรับตั้งค่า CORS credentials: true)
CLIENT_URL=http://localhost:5173
# Whitelist Origin ที่อนุญาตให้เรียก API ได้ (คั่นด้วย , ใช้เฉพาะตอน NODE_ENV=production เท่านั้น)
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://liff.line.me

# การตั้งค่า LINE Messaging API & LIFF App (รับค่าได้จาก LINE Developers Console)
LINE_CHANNEL_ACCESS_TOKEN=your_line_messaging_channel_access_token
LINE_CHANNEL_SECRET=your_line_messaging_channel_secret
LINE_LIFF_ID=your_liff_id
# Channel ID ของ LIFF App (ตัวเลขส่วนหน้าของ LINE_LIFF_ID ก่อนขีด) ใช้ตรวจสอบ LINE ID Token ที่ Client ส่งมา
LINE_LIFF_CHANNEL_ID=your_liff_channel_id
# ตั้งเป็น true เฉพาะตอน Dev/Test บนเครื่อง เพื่อข้ามการยิง Network Request ไปตรวจ ID Token กับ LINE จริง (ห้ามเปิดบน Production)
LINE_AUTH_MOCK_MODE=false

# การตั้งค่า PromptPay เจ้าของหอพัก
PROMPTPAY_NUMBER=0812345678
